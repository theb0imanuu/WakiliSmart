// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "sqlite"
  url      = "file:../wakili.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  username      String     @unique
  name          String
  password_hash String
  role          String     // 'SECRETARY', 'ADVOCATE'
  created_at    DateTime   @default(now())
  blogPosts     BlogPost[]

  passwordResetToken       String?
  passwordResetExpires     DateTime?
}

model Client {
  id           String        @id @default(cuid())
  name         String
  phone        String        @unique
  email        String?       @unique
  notes        String?
  created_at   DateTime      @default(now())
  cases        Case[]
  appointments Appointment[]
  inquiries    Inquiry[]
}

model Inquiry {
  id          String   @id @default(cuid())
  status      String   @default("PENDING") // 'PENDING', 'CONVERTED'

  // Walk-in fields
  name        String?
  email       String?
  phone       String?
  message     String?
  urgency     String?

  client_id   String?
  client      Client?  @relation(fields: [client_id], references: [id])

  created_at  DateTime @default(now())
}

model Case {
  id          String        @id @default(cuid())
  case_number String        @unique
  title       String
  case_type   String
  status      String        @default("PENDING")
  filing_date DateTime
  notes       String?

  client_id   String
  client      Client        @relation(fields: [client_id], references: [id])

  created_at  DateTime      @default(now())
  invoices    Invoice[]
  Appointment Appointment[]
}

model Appointment {
  id         String            @id @default(cuid())
  date       DateTime
  purpose    String
  status     String            @default("PENDING")

  client_id  String
  client     Client            @relation(fields: [client_id], references: [id])
  case_id    String?
  case       Case?             @relation(fields: [case_id], references: [id])

  created_at DateTime          @default(now())
}

model Invoice {
  id           String        @id @default(cuid())
  amount       Float
  balance_due  Float
  status       String        @default("UNPAID") // 'PAID', 'UNPAID'
  serviceType  String
  due_date     DateTime

  case_id      String
  case         Case          @relation(fields: [case_id], references: [id])

  created_at   DateTime      @default(now())
  items        InvoiceItem[]
  payments     Payment[]
}

model InvoiceItem {
  id          String  @id @default(cuid())
  description String
  amount      Float
  invoice_id  String
  invoice     Invoice @relation(fields: [invoice_id], references: [id])
}

model Payment {
  id                    String        @id @default(cuid())
  amount                Float
  method                String
  transaction_reference String?
  date_recorded         DateTime      @default(now())
  invoice_id            String
  invoice               Invoice       @relation(fields: [invoice_id], references: [id])
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  category    String
  content     String
  bannerPath  String?
  status      String   @default("DRAFT")

  author_id   String
  author      User     @relation(fields: [author_id], references: [id])
  created_at  DateTime @default(now())
}

model Document {
  id        String   @id @default(cuid())
  name      String
  type      String // 'folder', 'pdf', 'doc', 'image', etc.
  size      String
  path      String
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
}

model PracticeArea {
  id        String   @id @default(cuid())
  slug      String   @unique
  icon      String
  title     String
  desc      String
  createdAt DateTime @default(now())
}
